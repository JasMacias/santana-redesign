---
import santanahomepresentatioin from "public/santana-home-presentation.png";
import santanaNewCollection from "public/santana-collection.png";
import santanaSets from "public/santana-sets.png";
import santanaSafaris from "public/santana-safaris.png";
import santanaAccessories from "public/santana-accesorios.png";
import santanaVestidos from "public/santana-vestidos.png";
import santanaBathingDresses from "public/santana-vestidos-de-baño.png";
import santanaTexanas from "public/santana-texanas.png";
---
<section class="mb-[1.875rem]">
  <picture>
    <img src={santanahomepresentatioin.src} alt="Santana home presentation" class="w-screen">
  </picture>
</section>
<section class="flex flex-col md:flex-row px-[0.625rem] gap-[1.25rem]  mb-[1.25rem]">
  <article class="grow-1">
    <a href="#">
      <picture>
        <img src={santanaNewCollection.src} alt="Santana new collection" class="w-full">
      </picture>
    </a>
  </article>
  <article class="grow-1">
    <a href="#">
      <picture>
          <img src={santanaSets.src} alt="Santana sets" class="w-full">
      </picture>
    </a>
  </article>
  <article class="grow-1">
    <a href="#">
      <picture>
        <img src={santanaSafaris.src} alt="Santana safaris" class="w-full">
      </picture>
    </a>
  </article>
</section>
<section class="flex flex-wrap mb-[4rem] px-[0.625rem] gap-[1.25rem] pb-[0.625rem]">
  <article class="grow-1">
    <a href="#">
      <picture>
        <img src={santanaAccessories.src} alt="Santana Accesorios" class="w-full">
      </picture>
    </a>
  </article>
  <article class="grow-1">
    <a href="#">
      <picture>
        <img src={santanaVestidos.src} alt="Santana Vestidos y enterizos" class="w-full">
      </picture>
    </a>
  </article>
  <article class="grow-1">
    <a href="#">
      <picture>
        <img src={santanaBathingDresses.src} alt="Santana Vestidos de baños" class="w-full">
      </picture>
    </a>
  </article>
  <article class="grow-1">
    <a href="#">
      <picture>
        <img src={santanaTexanas.src} alt="Santana botas texanas" class="w-full">
      </picture>
    </a>
  </article>
</section>
<section class="w-screen mb-[2.25rem]">
  <h2 class="text-center font-medium text-[2.125rem] leading-[2.5rem]">
    DESCUENTOS DEL MES 🔥
  </h2>
</section>
<section class="flex min-w-[200vw] mb-[5.5rem]">
  <article class="w-[21.75rem] h-[25rem] bg-gray-300"></article>
  <article class="w-[21.75rem] h-[25rem] bg-gray-400"></article>
  <article class="w-[21.75rem] h-[25rem] bg-gray-300"></article>
  <article class="w-[21.75rem] h-[25rem] bg-gray-400"></article>
  <article class="w-[21.75rem] h-[25rem] bg-gray-300"></article>
</section>





